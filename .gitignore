# Local machine configuration (contains account and database passwords)
config/config.json
position.cfg
config.cfg

# Calibration: screen positions calibrated on this machine
config/calibration.json
config/calib_refs/

# What the modules remember between runs: when each one last ran, the players'
# names and the tournaments already sent to each clan site
config/module_state.json
config/module_data/

# Held by the run in progress, so two runs never drive the browser at once
config/run.lock

# Execution logs and environment
execution_logs/
venv/
python/

# Python
__pycache__/
*.pyc
